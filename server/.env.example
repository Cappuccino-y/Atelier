# Atelier server .env example — copy to .env and edit.
# All values shown are the Atelier defaults; override per environment.

# ============================================================
# Server bind
# ============================================================
PORT=8787
HOST=127.0.0.1

# ============================================================
# Agent runtime
# ============================================================
# "opencode" = real agent process per call
# "mock"     = fake responses for UI development (no opencode CLI required)
AGENT_RUNTIME=opencode

# Default model key. Used when an agent has no entry in agent-models.json.
# Format: <provider>/<model-id>
# Open `server/agent-models.json` to set per-agent overrides — that file
# is the recommended place to customize, not this env var.
# Atelier ships no default — set this to a model key your opencode.json `provider.*` declares.
OPENCODE_MODEL=

# Per-agent model config location (override only if you relocate the file)
# AGENT_MODELS_FILE=./agent-models.json

# Maximum wall-clock per single agent invocation (ms). 10 minutes is fine
# for normal coding; bump to 30 if Lens/Forge start timing out on big tasks.
OPENCODE_TIMEOUT=600000

# Maximum handoff depth per user message — caps recursion.
# Default 50 matches the spec; raise only if you see depth warnings.
OPENCODE_HANDOFF_DEPTH=50

# Map Atelier agent id -> opencode agent id. Format: "atlas:atlas,forge:build,lens:lens,..."
# - atlas/forge/lens/echo/trainer/scout/analyst/writer/archivist/vis
#   -> the per-agent primary agents defined in opencode.json
# - forge                    -> opencode's built-in "build" primary agent (full tools)
# v2 roster (8 agents): atlas / forge / lens / echo / trainer / scout / analyst / writer / archivist / vis
AGENT_MAPPING=atlas:atlas,forge:build,lens:lens,echo:echo,trainer:trainer,scout:scout,analyst:analyst,writer:writer,archivist:archivist,vis:vis

# ============================================================
# Proserpina review bridge (optional)
# ============================================================
PROSERPINA_URL=http://127.0.0.1:8765

# ============================================================
# Storage
# ============================================================
# SQLite database path (relative to server/ directory)
DB_PATH=./data/atelier.db
# Log directory (relative to server/ directory)
LOG_DIR=../logs